/dist/

# 发行安装包目录（M-7：曾因未覆盖导致 138MB 二进制险些入库，禁止跟踪）
/1.0.0+*/
/2.0.0+*/
/[0-9]*.[0-9]*.[0-9]*+*/

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Go node daemon build artifacts
node/irix-node
node/irix-node.exe
node/bin/
node/data/

